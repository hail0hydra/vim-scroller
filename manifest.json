{
  "manifest_version": 3,
  "name": "Vim Scroller",
  "version": "1.0",
  "description": "Use Vim keys to navigate pages.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
