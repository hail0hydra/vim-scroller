{
  "manifest_version": 3,
  "name": "Vim Scroller",
  "version": "1.0",
  "description": "Use Vim keys to navigate pages.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "48": "icon/icon.png"
  },
  "applications": {
    "gecko": {
      "id": "vim-scroller@example.com"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vim-scroller@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": []
    }
  }
}
